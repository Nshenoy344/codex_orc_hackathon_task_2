 #include "franka_hardware/robot.hpp"
 
 namespace franka_hardware {
+namespace {
+
+// libfranka promotes its constructor's calling thread to FIFO99. Restore only
+// that caller afterwards, before ROS/DDS descendants inherit the promotion.
+// The controller-manager update loop retains its own explicit FIFO policy.
+class ConstructorSchedulerRestore {
+ public:
+  ConstructorSchedulerRestore() : thread_(pthread_self()) {
+    const int error = pthread_getschedparam(thread_, &policy_, &parameters_);
+    if (error != 0) {
+      throw std::system_error(error, std::generic_category(),
+                              "Cannot save scheduler before libfranka construction");
+    }
+  }
+
+  ~ConstructorSchedulerRestore() noexcept {
+    if (active_) {
+      const int error = pthread_setschedparam(thread_, policy_, &parameters_);
+      if (error != 0) {
+        std::fprintf(stderr, "franka_hardware: scheduler rollback failed: %s\n",
+                     std::strerror(error));
+      }
+    }
+  }
+
+  void restore() {
+    const int error = pthread_setschedparam(thread_, policy_, &parameters_);
+    if (error != 0) {
+      throw std::system_error(error, std::generic_category(),
+                              "Cannot restore scheduler after libfranka construction");
+    }
+    active_ = false;
+  }
+
+ private:
+  pthread_t thread_;
+  int policy_{};
+  sched_param parameters_{};
+  bool active_{true};
+};
+
+}  // namespace
 
